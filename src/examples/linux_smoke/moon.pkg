import {
  "Nanaloveyuki/moonview",
  "Nanaloveyuki/moonview/examples/contract",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "host.c" ],
  link: {
    "native": {
      "stub-cc-flags": "${build.MOONVIEW_WEBKITGTK_STUB_CC_FLAGS}",
      "cc-link-flags": "${build.MOONVIEW_WEBKITGTK_CC_LINK_FLAGS}",
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
